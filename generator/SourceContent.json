# Mouse Wheel Ability Scroll Binding
def mouse_wheel_binding(event):
    if event.delta < 0: #Scroll Down
        scrollDown()
    else: #Scroll Up
        scrollUp()
app.bind("<Shift-MouseWheel>", mouse_wheel_binding)
